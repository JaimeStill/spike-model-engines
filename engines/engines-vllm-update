#!/usr/bin/env bash
# engines:summary=Move vllm to the pinned release and row or VLLM_MODEL's; remove other vLLM images
# Serves the pin's default row (vllm-rows), or the row VLLM_MODEL names for this run, so a plain
# update returns to the default. Pulls the pinned image before replacing the container, so a failed
# pull leaves the old release serving. The container moves when anything it serves differs from
# the row's: its image, its model, or a server flag. When the image is already the pin's, as when
# only the row changes, it replaces the container without pulling. When it already serves the
# row exactly and no other image is left, it changes nothing; when that container is stopped, it
# says docker start starts it, and never starts it itself. It refuses a VLLM_MODEL with no row,
# listing the rows, and refuses while the llama container runs, since one engine serves per host
# at a time.
set -euo pipefail
# shellcheck source=engines/vllm.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/vllm.sh"

engines_refuse_running llama
vllm_row
serves=$(vllm_serves)

running=$(vllm_running)
if [[ -z $running ]]; then
  echo "vllm is not installed; engines vllm install installs it" >&2
  exit 1
fi

served=$(vllm_served "$VLLM_IMAGE")
changed=
if [[ $running != "$served" ]]; then
  vllm_preflight
  [[ ${running%% *} == "$VLLM_IMAGE" ]] || docker pull "$VLLM_IMAGE"
  docker rm --force "$VLLM_CONTAINER" >/dev/null
  vllm_run "$VLLM_IMAGE" >/dev/null
  if [[ $(vllm_describe "$running") == "$(vllm_describe "$served")" ]]; then
    echo "vllm restarted $VLLM_IMAGE under the server flags of $serves"
  else
    echo "vllm moved from $(vllm_describe "$running") to $VLLM_IMAGE with $serves"
  fi
  changed=yes
fi
removed=$(vllm_remove_images "$VLLM_IMAGE")
[[ -n $removed ]] && echo "$removed"
stopped=
[[ -n $changed ]] || stopped=$(engines_stopped "$VLLM_CONTAINER")
if [[ -n $stopped ]]; then
  echo "vllm is installed with $VLLM_IMAGE and $serves but stopped;" \
    "docker start vllm starts it"
elif [[ -z $changed$removed ]]; then
  echo "vllm already runs $VLLM_IMAGE with $serves; nothing changed"
fi
