#!/usr/bin/env bash
# engines:summary=Move vllm to the pinned release and model and remove every other vLLM image
# Pulls the pinned image before replacing the container, so a failed pull leaves the old release
# serving. The container moves when either its image or its model differs from the pin. When it
# already runs both and no other image is left, it changes nothing. It refuses while the llama
# container runs, since one engine serves per host at a time.
set -euo pipefail
# shellcheck source=engines/vllm.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/vllm.sh"

engines_refuse_running llama

running=$(vllm_running)
if [[ -z $running ]]; then
  echo "vllm is not installed; engines vllm install installs it" >&2
  exit 1
fi

changed=
if [[ $running != "$VLLM_IMAGE $VLLM_MODEL" ]]; then
  vllm_preflight
  docker pull "$VLLM_IMAGE"
  docker rm --force "$VLLM_CONTAINER" >/dev/null
  vllm_run "$VLLM_IMAGE" >/dev/null
  echo "vllm moved from ${running/ / with } to $VLLM_IMAGE with $VLLM_MODEL"
  changed=yes
fi
removed=$(vllm_remove_images "$VLLM_IMAGE")
[[ -n $removed ]] && echo "$removed"
[[ -n $changed$removed ]] || echo "vllm already runs $VLLM_IMAGE with $VLLM_MODEL; nothing changed"
