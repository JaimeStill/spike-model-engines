#!/usr/bin/env bash
# engines:summary=Run vllm serve on the pinned model, at the pinned release or the release given
# Starts the vllm container (vllm.sh) from the pinned image, or from the release given, such as
# v0.31.0, serving the pinned model either way. When the container already runs that image and
# the pinned model it changes nothing; when it runs another it says which. It refuses while the
# llama container runs, since one engine serves per host at a time.
set -euo pipefail
# shellcheck source=engines/vllm.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/vllm.sh"

engines_refuse_running llama

image=$(vllm_image "${1:-$VLLM_RELEASE}")
running=$(vllm_running)

if [[ $running == "$image $VLLM_MODEL" ]]; then
  echo "vllm already runs $image with $VLLM_MODEL; nothing changed"
  exit 0
elif [[ -n $running ]]; then
  echo "vllm runs ${running/ / with }, not $image with $VLLM_MODEL;" \
    "engines vllm update moves it to the pin" >&2
  exit 1
fi

vllm_preflight
docker pull "$image"
vllm_run "$image" >/dev/null
echo "vllm runs $image with $VLLM_MODEL on $VLLM_ADDR:8000; docker logs -f vllm shows its start"
