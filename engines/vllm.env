# The vLLM pin: the latest GitHub release, the image built from it, and the one model the server
# serves, which moves with the release rather than on demand. The image is the release's default
# tag, vLLM's CUDA 13.0 multi-arch build, not a variant such as -ubuntu2404 or -cu129: both pinned
# releases of the update walk (v0.31.0, v0.32.0) publish it for arm64. Sourced by
# scripts/currency.sh and engines/vllm.sh.
VLLM_RELEASE=v0.32.0
VLLM_IMAGE=vllm/vllm-openai:$VLLM_RELEASE
VLLM_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
