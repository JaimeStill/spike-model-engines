# The llama.cpp pin: the latest semver release and the b-build its notes name ("Nightly build:"),
# which is the build that runs, and the repository of ggml's images. One build serves every flavor:
# host/llama.sh names the server image server-<flavor>-<build> in LLAMA_REPOSITORY. Sourced by
# host/llama-release.sh.
LLAMA_RELEASE=v0.7.0
LLAMA_BUILD=b11669
LLAMA_REPOSITORY=ghcr.io/ggml-org/llama.cpp
