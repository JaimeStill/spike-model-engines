#!/usr/bin/env bash
# engines:summary=Move native vLLM to the pinned or given release and row; remove other releases
# Moves native vLLM to the pinned release, or to the release given, such as v0.31.0, serving the
# pin's default row (vllm-rows), or the row VLLM_MODEL names for this run, so a plain update
# returns to both defaults. An older release is a rollback, the same way. It compares the row file
# with the row, as the container's update compares its command, so it moves when the release, the
# model, or a server flag differs. It builds that release into /opt/vllm unless it is there, with
# FlashInfer's kernels, while the old release still serves; then stops vllm-server, since two
# servers can't share the memory reservation, points current at the release and writes the row
# file, starts vllm-server, and waits up to 10 minutes until it answers (vllm-native.sh). Only
# once the release serves does it remove every other release, so a failed build or start leaves
# the old release in place for an update back to it, which a failed start names. It prints the server's /version and torch's
# CUDA after every start. When vllm-server already serves that release and row and no other
# release is left, it changes nothing; when it doesn't serve, it enables and starts it. It refuses
# while the llama or vllm container runs, or native llama.cpp's llama-router unit is active, since
# one engine serves per host at a time, refuses when native vLLM isn't installed, and refuses,
# pointing at the setup guide, until the architect's root steps are done and the host env's uv is
# installed. It refuses a release that isn't one, or a VLLM_MODEL with no row, listing the rows,
# before it reads Docker or the host.
set -euo pipefail
# shellcheck source=host/vllm-native.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/vllm-native.sh"

release=$(vllm_native_release "${1:-}")
vllm_row
serves=$(vllm_serves)
row=$(vllm_row_words "$VLLM_MODEL")
engines_refuse_running llama
engines_refuse_running vllm
engines_refuse_unit llama-router
vllm_native_preflight

current=$(vllm_native_current)
if [[ -z $current ]]; then
  echo "native vLLM is not installed; engines vllm-native install installs it" >&2
  exit 1
fi
written=$(vllm_native_row)
model=${written%%$'\n'*}

moved=()
if [[ $current != "$release" ]]; then
  moved+=("$VLLM_UNIT moved from $current to $release")
fi
if [[ $written != "$row" && $model == "${VLLM_ARGS[0]}" ]]; then
  moved+=("$VLLM_UNIT restarted under the server flags of $serves")
elif [[ $written != "$row" ]]; then
  moved+=("$VLLM_UNIT's row moved from ${model:-nothing} to $serves")
fi

served=
if ((${#moved[@]})); then
  vllm_native_build "$release"
  vllm_native_stop
  vllm_native_link "$release"
  vllm_native_write_row
  if ! vllm_native_serve; then
    [[ $current == "$release" ]] ||
      echo "$current stays in $VLLM_NATIVE_DIR; engines vllm-native update $current moves back" \
        "to it" >&2
    exit 1
  fi
  printf '%s\n' "${moved[@]}"
  served=yes
elif ! vllm_native_serving; then
  vllm_native_serve
  echo "$VLLM_UNIT serves $release with $serves again"
  served=yes
fi
removed=$(vllm_native_remove_releases "$release")
[[ -n $removed ]] && echo "$removed"
if [[ -n $served ]]; then
  vllm_native_versions
elif [[ -z $removed ]]; then
  echo "$VLLM_UNIT already serves $release with $serves; nothing changed"
fi
