#!/usr/bin/env bash
# engines:summary=Move vllm to the pinned release and row or VLLM_MODEL's; remove other vLLM images
# Serves the flavor's default row (vllm-rows), or the row VLLM_MODEL names for this run, so a plain
# update returns to the default. The image's flavor, its devices, and its default row are
# install's: VLLM_FLAVOR's, cuda or rocm, or with none given the host's GPU's (vllm_flavor). Pulls
# the pinned image before replacing the container, so a failed pull leaves the old release
# serving. The container moves when anything it serves differs from the row's: its image (another
# release's or another flavor's), its model, or a server flag. When the image is already the
# pin's, as when only the row changes, it replaces the container without pulling. When it already
# serves the row exactly and no other image is left, it changes nothing; when that container is
# stopped, it says docker start starts it, and never starts it itself. It refuses an unknown
# flavor before it reads Docker, a VLLM_MODEL with no row, listing the rows, and refuses while
# the llama container runs, or any llama-router unit (native llama.cpp's, or another project's of
# that name) or native vLLM's vllm-server unit is active, since one engine serves per host at a
# time.
set -euo pipefail
# shellcheck source=host/vllm.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/vllm.sh"

vllm_flavor
engines_refuse_running llama
engines_refuse_unit llama-router
engines_refuse_unit vllm-server
vllm_row
serves=$(vllm_serves)
image=$(vllm_image "$VLLM_RELEASE")

running=$(vllm_running)
if [[ -z $running ]]; then
  echo "vllm is not installed; engines vllm install installs it" >&2
  exit 1
fi

served=$(vllm_served "$image")
changed=
if [[ $running != "$served" ]]; then
  vllm_preflight
  [[ ${running%% *} == "$image" ]] || docker pull "$image"
  docker rm --force "$VLLM_CONTAINER" >/dev/null
  vllm_run "$image" >/dev/null
  if [[ $(vllm_describe "$running") == "$(vllm_describe "$served")" ]]; then
    echo "vllm restarted $image under the server flags of $serves"
  else
    echo "vllm moved from $(vllm_describe "$running") to $image with $serves"
  fi
  changed=yes
fi
removed=$(vllm_remove_images "$image")
[[ -n $removed ]] && echo "$removed"
stopped=
[[ -n $changed ]] || stopped=$(engines_stopped "$VLLM_CONTAINER")
if [[ -n $stopped ]]; then
  echo "vllm is installed with $image and $serves but stopped;" \
    "docker start vllm starts it"
elif [[ -z $changed$removed ]]; then
  echo "vllm already runs $image with $serves; nothing changed"
fi
