#!/usr/bin/env bash
# engines:summary=Move native llama.cpp to the pin or the version given; remove other builds
# Moves native llama.cpp to the pinned build, or to the build for the version given, as install
# reads it: a semver release, such as v0.6.0, runs the b-build its notes name, and a b-build, such
# as b11429, runs as given. An older version is a rollback, the same way. It fetches that build
# into /opt/llama.cpp unless it is there, points current at it (and preset at the clone's preset
# directory, when it names anywhere else, as after the clone moves), restarts llama-router, and
# waits until it answers (llama-native.sh). Only once the build serves does it remove every other
# build, so a failed fetch or start leaves the old build in place for an update back to it. When
# llama-router already serves that build with the clone's preset and no other build is left, it
# changes nothing; when it doesn't serve, it enables and starts it. It refuses while the llama or
# vllm container runs or native vLLM's vllm-server unit is active, since one engine serves per
# host at a time, refuses when native llama.cpp isn't installed, and refuses, pointing at the
# setup guide, until the architect's root steps are done. It refuses a version that is neither, or
# a release whose notes it can't read, before it reads Docker or the host.
set -euo pipefail
# shellcheck source=host/llama-native.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/llama-native.sh"

build=$(llama_build "${1:-}")
engines_refuse_running "$LLAMA_CONTAINER"
engines_refuse_running vllm
engines_refuse_unit vllm-server
llama_native_preflight

current=$(llama_native_current)
if [[ -z $current ]]; then
  echo "native llama.cpp is not installed; engines llama-native install installs it" >&2
  exit 1
fi
preset=$(llama_native_preset)

moved=()
if [[ $current != "$build" ]]; then
  llama_native_fetch "$build"
  llama_native_link current "$build"
  moved+=("$LLAMA_UNIT moved from $current to $build")
fi
if [[ $preset != "$LLAMA_PRESET_DIR" ]]; then
  llama_native_link preset "$LLAMA_PRESET_DIR"
  moved+=("$LLAMA_UNIT's preset moved from ${preset:-nothing} to $LLAMA_PRESET_DIR")
fi

served=
if ((${#moved[@]})); then
  llama_native_serve restart
  printf '%s\n' "${moved[@]}"
  served=yes
elif ! llama_native_serving; then
  llama_native_serve
  echo "$LLAMA_UNIT serves $build again"
  served=yes
fi
removed=$(llama_native_remove_builds "$build")
[[ -n $removed ]] && echo "$removed"
[[ -n $served$removed ]] || echo "$LLAMA_UNIT already serves $build; nothing changed"
