# The vLLM pin: the latest GitHub release, the image repository of each flavor, the row each
# flavor serves by default, which moves with the release rather than on demand, and native vLLM's
# Python. One release serves every flavor: host/vllm.sh names the image <repository>:<release>,
# in the repository of the flavor it resolves (vllm_flavor). cuda's is the release's default tag,
# vLLM's CUDA 13.0 multi-arch build, not a variant such as -ubuntu2404 or -cu129: both pinned
# releases of the update walk (v0.31.0, v0.32.0) publish it for arm64. rocm's is vLLM's official
# ROCm image of the same release. Sourced by scripts/currency.sh, which reads only the release,
# and host/vllm.sh, and through it host/vllm-native.sh.
#
# A row is a model and its server flags, in the rows file VLLM_ROWS names, beside this one.
# VLLM_MODEL_CUDA and VLLM_MODEL_ROCM name each flavor's default row; a VLLM_MODEL in the
# environment names another for one run, with no edit here (docs/engines/vllm/models.md,
# "Changing the model").
#
# Held on v0.32.0: vLLM's latest GitHub release, v0.33.0rc3, is a release candidate, and vLLM is
# being removed from both hosts, so currency reports the release behind its latest until vLLM's
# pins are removed.
VLLM_RELEASE=v0.32.0
VLLM_REPOSITORY_CUDA=vllm/vllm-openai
VLLM_REPOSITORY_ROCM=vllm/vllm-openai-rocm
VLLM_ROWS=vllm-rows
VLLM_MODEL_CUDA=gemma-4-26B-A4B-NVFP4
VLLM_MODEL_ROCM=gpt-oss-120b

# Native vLLM's Python (vllm-native.sh): the CPython minor version uv installs for each release's
# virtualenv. Held on 3.12, the image's Python, so the two hosting methods differ only in how they
# are hosted, and currency reports Python behind its latest until it moves. Native vLLM is retired
# on both hosts, so nothing moves it now: it stays held until vLLM's pins are removed.
VLLM_NATIVE_PYTHON=3.12
