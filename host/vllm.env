# The vLLM pin: the release, each flavor's image repository and default row, the trace collector,
# and native vLLM's Python.
# See docs/engines/vllm/update.md#how-the-pin-moves
# See docs/engines/vllm/models.md#changing-the-model
VLLM_RELEASE=v0.34.0
VLLM_REPOSITORY_CUDA=vllm/vllm-openai
VLLM_REPOSITORY_ROCM=vllm/vllm-openai-rocm
VLLM_ROWS=vllm-rows
VLLM_MODEL_CUDA=gemma-4-26B-A4B-NVFP4
VLLM_MODEL_ROCM=gpt-oss-120b

# See docs/engines/vllm/models.md#tracing-a-row-for-one-run
VLLM_TRACE_COLLECTOR=gb10-2:4317

# Held on 3.12, the image's Python, so the two hosting methods differ only in how they are hosted;
# currency reports Python behind its latest until it moves. Native vLLM is retired on both hosts,
# so nothing moves it now: it stays held until vLLM's pins are removed.
VLLM_NATIVE_PYTHON=3.12
