# The vLLM pin: the latest GitHub release, the image built from it, the row the server serves by
# default, which moves with the release rather than on demand, and native vLLM's Python. The image
# is the release's default tag, vLLM's CUDA 13.0 multi-arch build, not a variant such as
# -ubuntu2404 or -cu129: both pinned releases of the update walk (v0.31.0, v0.32.0) publish it for
# arm64. Sourced by scripts/currency.sh and host/vllm.sh, and through it host/vllm-native.sh.
#
# A row is a model and its server flags, in the rows file VLLM_ROWS names, beside this one.
# VLLM_MODEL names the default row; a VLLM_MODEL already in the environment names another for one
# run, with no edit here (docs/engines/vllm/models.md, "Changing the model").
VLLM_RELEASE=v0.32.0
VLLM_IMAGE=vllm/vllm-openai:$VLLM_RELEASE
VLLM_ROWS=vllm-rows
VLLM_MODEL=${VLLM_MODEL:-gemma-4-26B-A4B-NVFP4}

# Native vLLM's Python (vllm-native.sh): the CPython minor version uv installs for each release's
# virtualenv. Held on 3.12, the image's Python, so the two hosting methods differ only in how they
# are hosted, and currency reports Python behind its latest until it moves: revisit it when the
# image's Python moves, not when Python's does.
VLLM_NATIVE_PYTHON=3.12
