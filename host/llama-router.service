# Native llama.cpp's router: llama-server in router mode under systemd.
# See docs/engines/llama.cpp/setup.md#1-the-architects-root-steps

[Unit]
Description=llama.cpp router, native (spike-model-engines)
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=jaime
Environment=LLAMA_CACHE=/srv/models
ExecStart=/usr/bin/bash -c 'addr=$$(tailscale ip -4) && exec /opt/llama.cpp/current/llama-server --models-preset /opt/llama.cpp/preset/models.ini --no-models-autoload --host "$$addr" --port 8080'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
